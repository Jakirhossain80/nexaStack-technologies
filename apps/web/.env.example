# NexaStack Technologies — apps/web environment
# Copy to apps/web/.env.local and fill in real values. NEVER commit .env files.
# Every NEXT_PUBLIC_ variable is embedded in the browser bundle — never put a secret here.
#
# Lists only variables the code reads today (validated in lib/env.ts). Planned variables are
# listed in README.md and are added here in the change that first reads them.

# Absolute public URL of the site, no trailing slash. Used for metadataBase, sitemap.xml and
# robots.txt. Required for production builds; defaults to http://localhost:3000 in
# development. The domain is still an open decision (CLAUDE.md 22.1).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile site key, used by the widget on the /contact form and on the final step of
# the /quotation form. Optional in development: when unset, the widget does not render. Not a
# secret. See TURNSTILE_SECRET_KEY below for what the server then does.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAE-Ej7JwTJL5K_KA

# Google Search Console's site-ownership verification code. Optional and not a secret — it only
# does anything once Jakir registers a real domain (CLAUDE.md 22.1) as a property in his own
# Search Console account and gets a real code back. Until then, leave unset: the root layout
# renders no verification meta tag at all rather than an empty/fake one.
GOOGLE_SITE_VERIFICATION=

# REQUIRED for /admin/*. The Express API's origin, no trailing slash — root CLAUDE.md 22.5
# reserves apps/api for the admin interface, so the admin login form and the protected-route
# session check both call it directly. Not a secret. Defaults to http://localhost:4000 in
# development; required for production builds. Also allow-listed as the `connect-src` origin in
# the Content-Security-Policy set by next.config.ts, so a wrong value here blocks admin requests.
NEXT_PUBLIC_API_URL=http://localhost:4000

# REQUIRED. MongoDB connection string (mongodb:// or mongodb+srv://), used by /api/contact and
# /api/quotation to persist submissions and by the public /blog pages to read published posts.
# Read by apps/web/lib/env.server.ts, never exposed to the browser. Use a dummy value here: a
# real connection string (with its password) belongs ONLY in the gitignored apps/web/.env.local.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/nexastack?retryWrites=true&w=majority

# Cloudflare Turnstile secret key, used server-side by /api/contact and /api/quotation to verify
# the widget token. REQUIRED IN PRODUCTION: with NODE_ENV=production and this unset, both forms
# refuse submissions (503) and log an error, so bot protection can never be silently off on a
# live site. In development, unset means the check is skipped with a console warning.
TURNSTILE_SECRET_KEY=0x4AAAAAAE-Ej2NQVLizPd_fQ8ZB09aGcgM

# Transactional email provider key (Resend). RESERVED: no provider is chosen yet (root CLAUDE.md
# 22.4), so nothing is sent today and setting this has no effect. It is read by
# lib/notifications.ts so the eventual integration has one place to start. Server-side secret;
# never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=RESEND_API_KEY

# Cloudinary credentials, used server-side by /api/quotation/upload to store quotation
# attachments (root CLAUDE.md 15). All three are optional: when any is unset, the upload
# route returns a clear "not available yet" error instead of pretending to succeed, and the
# quotation form still submits without attachments.
# Attachments are stored as `authenticated` (not publicly reachable); apps/api needs the SAME
# three values (apps/api/.env) to retrieve them for the admin.
# CLOUDINARY_CLOUD_NAME also registers your Cloudinary account with next/image (next.config.ts), so
# blog cover images from the Media Library can be shown. It must be set at BUILD and run time; if it is
# not, such a cover is left out (with a one-line server warning) rather than breaking the page.
# Server-side secrets: put real values only in the gitignored apps/web/.env.local, NEVER in this
# committed file. Never prefix them with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

