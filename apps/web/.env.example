# NexaStack Technologies — apps/web environment
# Copy to apps/web/.env.local and fill in real values. NEVER commit .env files.
# Every NEXT_PUBLIC_ variable is embedded in the browser bundle — never put a secret here.
#
# Lists only variables the code reads today (validated in lib/env.ts). Planned variables are
# listed in README.md and are added here in the change that first reads them.

# Absolute public URL of the site, no trailing slash. Used for metadataBase, sitemap.xml and
# robots.txt. Required for production builds; defaults to http://localhost:3000 in
# development. The domain is still an open decision (CLAUDE.md 22.1).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile site key, used by the /contact form widget. Optional: when unset, the
# widget does not render and the /api/contact route skips spam verification (see
# TURNSTILE_SECRET_KEY below), logging a warning instead of blocking submissions.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# REQUIRED for /api/contact to persist submissions. MongoDB connection string (mongodb:// or
# mongodb+srv://). Read by apps/web/lib/env.server.ts, never exposed to the browser.
MONGODB_URI=mongodb+srv://nexaStack:nexaStack@cluster.mongodb.net/nexastack?retryWrites=true&w=majority

# Cloudflare Turnstile secret key, used server-side by /api/contact to verify the widget token.
# Optional in development: when unset, /api/contact logs a console warning and skips
# verification rather than blocking submissions or faking a pass. Set before deploying.
TURNSTILE_SECRET_KEY=
