# NexaStack Technologies — apps/api environment
# Copy to apps/api/.env and fill in real values. NEVER commit .env files.
#
# Lists only variables the code reads today. All are validated at startup by
# src/config/env.ts, which exits naming any missing or invalid variable. Planned variables are
# listed in README.md and are added here in the change that first reads them.

# development | test | production. Development enables pretty-printed logs. Default: development
NODE_ENV=development

# HTTP port. Default: 4000
PORT=4000

# REQUIRED. Comma-separated list of allowed browser origins (exact scheme://host:port).
# Each origin is trimmed, so spaces after commas are fine either way, e.g.
# "http://localhost:3000, https://nexastack.example" or "http://localhost:3000,https://nexastack.example".
# "*" is rejected because credentials are enabled.
CORS_ORIGINS=http://localhost:3000

# REQUIRED. MongoDB connection string (mongodb:// or mongodb+srv://).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/nexastack?retryWrites=true&w=majority

# fatal | error | warn | info | debug | trace | silent. Default: info
LOG_LEVEL=info

# Number of reverse-proxy hops in front of the API, so rate limiting sees the real client IP.
# 0 locally; 1 on Render. Default: 0
TRUST_PROXY=0

# REQUIRED. Signs and verifies admin session JWTs. Generate a long random value per
# environment, e.g. `openssl rand -hex 32` — never reuse the same one across dev/staging/
# production, and never commit a real value.
JWT_SECRET=

# REQUIRED. The public web app's origin (no trailing slash) — used only to build the
# password-reset link sent to the admin. http://localhost:3000 in development.
WEB_APP_URL=http://localhost:3000

# OPTIONAL. Cloudinary credentials, used to retrieve quotation attachments for the admin. Must be
# the same Cloudinary account as apps/web/.env.local. Attachments are stored as `authenticated`
# (not publicly reachable), so only this API can fetch them, after checking the admin session.
# If any is empty the API still starts, but attachment downloads return "not configured".
# Server-side only. NEVER commit real values.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Transactional email provider key (Resend). RESERVED: no provider is chosen yet (root CLAUDE.md
# 22.4), so nothing is sent today and setting this has no effect; the password-reset request only
# logs. Read by src/lib/mailer.ts (directly, not through src/config/env.ts, because it is inert).
# Server-side secret; NEVER commit a real value.
RESEND_API_KEY=

# Used ONLY by `pnpm run seed-admin` (apps/api/scripts/seed-admin.ts), a one-time operator
# script that creates the single real admin account — there is no public registration form.
# Not read by the running server. Set these temporarily to seed, then it's safe to leave them
# here (a placeholder) or remove them; the script no-ops if an admin account already exists.
# NEVER commit real values.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
