# NexaStack Technologies — apps/api environment
# Copy to apps/api/.env and fill in real values. NEVER commit .env files.
#
# Lists only variables the code reads today. All are validated at startup by
# src/config/env.ts, which exits naming any missing or invalid variable. Planned variables are
# listed in README.md and are added here in the change that first reads them.

# development | test | production. Development enables pretty-printed logs. Default: development
NODE_ENV=development

# HTTP port. Default: 4000
PORT=4000

# REQUIRED. Comma-separated list of allowed browser origins (exact scheme://host:port).
# Each origin is trimmed, so spaces after commas are fine either way, e.g.
# "http://localhost:3000, https://nexastack.example" or "http://localhost:3000,https://nexastack.example".
# "*" is rejected because credentials are enabled.
CORS_ORIGINS=http://localhost:3000

# REQUIRED. MongoDB connection string (mongodb:// or mongodb+srv://).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/nexastack?retryWrites=true&w=majority

# fatal | error | warn | info | debug | trace | silent. Default: info
LOG_LEVEL=info

# Number of reverse-proxy hops in front of the API, so rate limiting sees the real client IP.
# 0 locally; 1 on Render. Default: 0
TRUST_PROXY=0
