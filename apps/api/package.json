{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed-admin": "tsx --env-file-if-exists=.env scripts/seed-admin.ts",
    "backup-db": "tsx --env-file-if-exists=.env scripts/backup-db.ts",
    "migrate-enquiries": "tsx --env-file-if-exists=.env scripts/migrate-enquiry-status.ts",
    "migrate-admin-users": "tsx --env-file-if-exists=.env scripts/migrate-admin-users.ts",
    "migrate-quotations": "tsx --env-file-if-exists=.env scripts/migrate-quotation-status.ts",
    "migrate-quotation-attachments": "tsx --env-file-if-exists=.env scripts/migrate-quotation-attachments.ts"
  },
  "dependencies": {
    "@nexastack/shared": "workspace:*",
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "catalog:",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "catalog:",
    "pino-pretty": "13.1.3",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
