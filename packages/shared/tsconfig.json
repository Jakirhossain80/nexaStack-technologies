{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // No DOM and no @types/node: a stray `window`, `document` or `process` fails to compile,
    // which keeps this package environment-agnostic.
    "lib": ["ES2023"],
    "types": [],
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/test-utils/**"]
}
