{
  "name": "nexastack",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "pnpm --filter @nexastack/shared build",
    "build:shared": "pnpm --filter @nexastack/shared build",
    "dev": "pnpm build:shared && pnpm --parallel --filter @nexastack/shared --filter web --filter api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "test": "pnpm build:shared && pnpm -r --if-present test",
    "test:integration": "pnpm build:shared && node scripts/run-integration.mjs",
    "test:e2e": "pnpm build:shared && pnpm --filter e2e e2e",
    "test:e2e:full": "pnpm build:shared && pnpm --filter e2e e2e:full",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "catalog:",
    "typescript-eslint": "8.70.0"
  }
}
